# =============================================================================
# Touchpoint - Environment Configuration
# Copy this file to .env and adjust values before running docker compose up -d
# =============================================================================

# Server & Runtime
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1

# SQLite Database Path (inside container, mount ./data:/app/data)
DATABASE_PATH=/app/data/touchpoint.db

# Authentication Session Secret (Generate with: openssl rand -hex 32)
SESSION_SECRET=change-this-secret-on-your-raspberry-pi

# Container Structured Logging Level: debug | info | warn | error
LOG_LEVEL=info

# =============================================================================
# Authentication & Multi-User Flags (Optional)
# =============================================================================

# Disable authentication completely (Passwordless mode, zero security).
# Not recommended unless running entirely on a secured, isolated local network.
# Default: false
AUTH_DISABLED=false

# Multi-User Registration:
# By default (false), registration is locked immediately after the 1st user registers.
# Set to true to allow additional users to sign up and receive their own segregated databases.
# Default: false
ALLOW_SIGNUPS=false

# Webhook Security:
# Set to true to permit outgoing webhooks to local/private IP addresses (e.g. 192.168.x.x, 10.x.x.x).
# Default: false
ALLOW_PRIVATE_WEBHOOKS=false
